# Admin dashboard (/admin) — required in production.
# Long random string used to sign the admin session cookie.
ADMIN_SECRET=change-me-to-a-long-random-string

# Optional
# NEXT_PUBLIC_SITE_URL=https://eyrez.com
# DATA_DIR=/var/lib/eyrez        # where db.json is stored (default: ./data)
# SEED_DEMO_ORDERS=1             # add sample orders on first run in production
